# Visual Studio build output
x64/
Debug/
Release/
build/
*.obj
*.exe
*.ilk
*.pdb
*.idb
*.recipe
*.tlog
*.log

# Large source textures under assets/ — not needed until there is a texture
# pipeline. Delete these two lines to start tracking them.
assets/**/*.tga
assets/**/*.psd
# ...except the crowd diffuse, which MeshPass3D loads for the instanced zombies.
!assets/models/zombie/Zombie.tga

# tools/atlas_pack incremental-build hashes (regenerated; the .dds/.atlas are committed)
assets/atlas/*.cache

# Visual Studio local state
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
